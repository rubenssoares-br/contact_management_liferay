<?xml version="1.0"?>
<!DOCTYPE resource-action-mapping PUBLIC "-//Liferay//DTD Resource Action Mapping 7.4.0//EN" "http://www.liferay.com/dtd/liferay-resource-action-mapping_7_4_0.dtd">

<resource-action-mapping>
    <model-resource>
        <model-name>com.liferay.contact.management.model.Contact</model-name>
        <portlet-ref>
            <portlet-name>com_liferay_contact_management_ContactPortlet</portlet-name>
        </portlet-ref>
        <root>true</root>
        <permissions>
            <supports>
                <action-key>ADD_CONTACT</action-key>
                <action-key>UPDATE_CONTACT</action-key>
                <action-key>DELETE_CONTACT</action-key>
                <action-key>GET_CONTACT</action-key>
                <action-key>GET_ALL_CONTACTS</action-key>
            </supports>
            <site-member-defaults>
                <action-key>UPDATE_CONTACT</action-key>
            </site-member-defaults>
            <guest-defaults>
                <action-key>GET_CONTACT</action-key>
                <action-key>GET_ALL_CONTACTS</action-key>
            </guest-defaults>
            <guest-unsupported>
                <action-key>ADD_CONTACT</action-key>
                <action-key>DELETE_CONTACT</action-key>
            </guest-unsupported>
        </permissions>
    </model-resource>
    <model-resource>
        <model-name>com.liferay.contact.management.model.ContactEntry</model-name>
        <portlet-ref>
            <portlet-name>com_liferay_contact_management_portlet_ContactPortlet</portlet-name>
        </portlet-ref>
        <root>true</root>
        <permissions>
            <supports>
                <action-key>ADD_CONTACT_ENTRY</action-key>
                <action-key>UPDATE_CONTACT_ENTRY</action-key>
                <action-key>DELETE_CONTACT_ENTRY</action-key>
                <action-key>GET_CONTACT_ENTRY</action-key>
                <action-key>GET_ALL_CONTACT_ENTRIES</action-key>
                <action-key>GET_ENTRIES_BY_CONTACT_ID</action-key>
            </supports>
            <site-member-defaults>
                <action-key>UPDATE_CONTACT_ENTRY</action-key>
                <action-key>GET_ENTRIES_BY_CONTACT_ID</action-key>
            </site-member-defaults>
            <guest-defaults>
                <action-key>GET_CONTACT_ENTRY</action-key>
                <action-key>GET_ALL_CONTACT_ENTRIES</action-key>
            </guest-defaults>
            <guest-unsupported>
                <action-key>ADD_CONTACT_ENTRY</action-key>
                <action-key>DELETE_CONTACT_ENTRY</action-key>
            </guest-unsupported>
        </permissions>
    </model-resource>
</resource-action-mapping>
